# Public browser configuration. Never put credentials in VITE_* variables.
VITE_API_BASE_URL=/api

# Project page: development defaults to mock; production defaults to live.
# Explicitly set live when connecting the real project API.
# VITE_PROJECTS_SOURCE=live

# Optional development-only proxy; ignored by the production static bundle.
DEV_API_PROXY_TARGET=http://127.0.0.1:18080

# Enable only after backend supports q/access_state on GET /v1/projects.
VITE_PROJECTS_QUERY_API=false

# Documents follow the project source by default. Explicit live never falls back to fixtures.
# VITE_DOCUMENTS_SOURCE=live

# Download versions use VITE_API_BASE_URL + /v1/downloads. OSS feeds are configured on the backend.
